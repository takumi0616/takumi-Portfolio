# takumi-Portfolio/deploy/portfolio.service
# ── ポートフォリオ（Next.js）を常駐させる systemd user unit（自己完結・PersonalCast と独立）。
#
# 設置（sudo 不要・一度だけ）:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/portfolio.service ~/.config/systemd/user/portfolio.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now portfolio
#   loginctl enable-linger takumi0616    # ログアウト後も動かすために必須
# 確認:  systemctl --user status portfolio   /   curl -I http://127.0.0.1:3000/ja
# 停止:  systemctl --user stop portfolio
#
# 注: 手動 nohup（deploy/run_portfolio.sh）で起動中なら先に停止すること（ポート二重起動防止）。
[Unit]
Description=takumi Portfolio (Next.js) server

[Service]
Type=simple
WorkingDirectory=/home/takumi0616/takumi-Portfolio
Environment=NODE_ENV=production
Environment=PATH=/home/takumi0616/node-v22.21.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
# Node は minis-gpu 同梱の node v22.21.1。要 `npm ci && npm run build` 済み。
ExecStart=/home/takumi0616/node-v22.21.1-linux-x64/bin/node /home/takumi0616/takumi-Portfolio/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
